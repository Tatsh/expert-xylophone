      <dict>
        <key>CFBundleIconFiles</key>
        <array>
          <string>AppIcon60x60</string>
        </array>
      </dict>
    </dict>
    <key>CFBundleIcons~ipad</key>
    <dict>
      <key>CFBundlePrimaryIcon</key>
      <dict>
        <key>CFBundleIconFiles</key>
        <array>
          <string>AppIcon60x60</string>
          <string>AppIcon76x76</string>
        </array>
      </dict>
    </dict>
    <!-- The app has no dark assets, so on iOS 13+ its UIKit controls would render dark against
       artwork that assumes a light interface, leaving the store unreadable. -->
  <key>UIUserInterfaceStyle</key>
  <string>Light</string>
</dict>
</plist>
