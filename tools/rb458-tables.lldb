# Dump the runtime-seeded tables raw, for byte-exact comparison against the reconstruction.
#
#   (lldb) process interrupt
#   (lldb) command source /path/to/rb458-tables.lldb
#
# These tables are the reconstruction's blind spot. Each is declared `= {}` in the source and filled
# by a load-time constructor, so a wrong value compiles cleanly, survives the address audit (which
# checks that an annotated address exists, not what a constructor writes into it), and only shows up
# as a misplaced sprite. Reading them out of the running original settles every entry at once.
#
# Everything is dumped as raw words so no interpretation happens on the device; the decoding and the
# diff against the reconstruction happen off-device.
#
# No persistent variables and no calls into the target, so this can be sourced alongside the other
# scripts in the same session.

# g_pTutorialClipRect: 34 CGRects of four doubles (@ghidraAddress 0x3de058), seeded by
# SetupDialogLayoutCoordTable at 0x1414e0. Entries 9 and 28 are the tutorial message strip and its
# window; the rest have never been checked.
memory read -f x -s 8 -c 136 `(uint64_t)&_mh_execute_header + 0x3de058`

# g_aAltFrameMarker4: 10 records of {int spriteKind, float x, y, rotation, scaleX, scaleY}
# (@ghidraAddress 0x3dbec8), seeded by SeedAltFrameLayoutTable at 0x17b218.
memory read -f x -s 4 -c 60 `(uint64_t)&_mh_execute_header + 0x3dbec8`

# g_aAltFrameMarker6: 14 records, same shape (@ghidraAddress 0x3dbfb8).
memory read -f x -s 4 -c 84 `(uint64_t)&_mh_execute_header + 0x3dbfb8`

# g_aAltFrameMarker9: 12 records, same shape (@ghidraAddress 0x3dc108).
memory read -f x -s 4 -c 72 `(uint64_t)&_mh_execute_header + 0x3dc108`

# The pastel layer's own clip table, shared with RBTutorialPastel (@ghidraAddress 0x3df3e0): four
# CGRects of four doubles, seeded at 0x1b81d8.
memory read -f x -s 8 -c 16 `(uint64_t)&_mh_execute_header + 0x3df3e0`

# The pastel child layout points (@ghidraAddress 0x3df460): four CGPoints of two doubles.
memory read -f x -s 8 -c 8 `(uint64_t)&_mh_execute_header + 0x3df460`
