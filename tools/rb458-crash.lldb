# Dump the GL client-array state at the play-screen crash.
#
# This LLDB has no script interpreter, so it cannot find the right frame itself. Select the frame
# first, then source this file:
#
#   (lldb) bt
#   (lldb) frame select 6            <- the ne::C_SPRITE_INSTANCING_2D::EmitMatrixSprites frame
#   (lldb) command source /var/jb/var/mobile/rb458-crash.lldb
#
# Frame 6 is what every crash report so far shows, under five driver frames and glDrawElements_IMM_
# Exec, but read the backtrace rather than trusting the number.
#
# Nothing here calls into the target: a jailbroken attach cannot install the expression checkers, so
# expr and p would fail. frame variable reads memory through debug info instead. There are no
# persistent ($) variables, so this can be sourced more than once in a session.
#
# The fault is a null client array. The element buffer and vertex array are already ruled out by the
# instrumented build, leaving colour, texture coordinate, weight, and matrix index. The array that
# is enabled in m_aClientStateFlags, has a null pointer, and has no buffer bound is the one.
#
# If these all answer "no variable named ...", the build has symbols but no debug info; say so and
# a different approach is needed. Do not substitute the +0xNN offsets from neGLES.h -- those
# describe the original 32-bit object, not this build.

frame variable *this
frame variable *pRenderer

# The same fields singly, in case either aggregate above is truncated or refuses to dereference.
frame variable pRenderer->m_aClientStateFlags
frame variable pRenderer->m_nArrayBufferBound
frame variable pRenderer->m_nElementBufferBound
frame variable pRenderer->m_pVertexPointer
frame variable pRenderer->m_pColorPointer
frame variable pRenderer->m_apTexCoordPointer
frame variable pRenderer->m_pWeightPointer
frame variable pRenderer->m_pMatrixIndexPointer
frame variable pRenderer->m_nVertexBufferBinding
frame variable pRenderer->m_nColorBufferBinding
frame variable pRenderer->m_nWeightBufferBinding
frame variable pRenderer->m_nMatrixIndexBufferBinding
frame variable this->m_dwIndexVbo
frame variable this->m_dwArrayVbo
frame variable this->m_pVertexScratch
frame variable this->m_nSpriteCount
