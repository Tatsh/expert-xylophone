# Dump everything needed to compare the original against the reconstruction, in one go.
#
#   (lldb) process interrupt
#   (lldb) command source /path/to/rb458-dump.lldb
#
# Every line is a self-contained memory read. There are deliberately no persistent ($) variables:
# LLDB keeps those for the whole session and refuses to redefine one, so sourcing a second script
# fails with "redefinition of persistent variable". There are also no calls into the target, since
# a jailbroken attach often cannot install the expression checkers.
#
# Addresses are image-relative, as the @ghidraAddress tags record them, rebased through the linker's
# _mh_execute_header so ASLR does not matter. GameSystem is the pointer at 0x3de010 (what
# GetGameSystem returns), IsPad is the byte at 0x3df3d0, g_pAltFrameLayer is at 0x3deda8 with
# m_apSprites[i] at +0x20 + i*8, and g_pTutorialClipRect is at 0x3de058.
#
# Run it while stopped on the play screen. Values print in the order of the comments.


# isPad (1 = pad geometry, 0 = phone + halved clip rects)
expr -- (int)*(unsigned char *)((uint64_t)&_mh_execute_header + 0x3df3d0)

# viewport width
expr -- *(float *)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3de010) + 44)

# viewport height
expr -- *(float *)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3de010) + 48)

# sheetFarX
expr -- *(float *)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3de010) + 124)

# sheetFarY
expr -- *(float *)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3de010) + 128)

# sheetPosX
expr -- *(float *)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3de010) + 88)

# sheetPosY
expr -- *(float *)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3de010) + 92)

# playfieldScale
expr -- *(float *)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3de010) + 308)

# sheetWidth (fov degrees)
expr -- *(float *)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3de010) + 160)

# g_nPlayfieldFullHeightY
expr -- *(int *)((uint64_t)&_mh_execute_header + 3997704)

# g_nPlayfieldCentreSplit
expr -- *(int *)((uint64_t)&_mh_execute_header + 3991860)

# g_nPlayfieldFieldHeight
expr -- *(int *)((uint64_t)&_mh_execute_header + 3991856)

# g_pAltFrameLayer (null means the play scene has not built it)
expr -- *(void **)((uint64_t)&_mh_execute_header + 0x3deda8)

# batch 0: capacity
expr -- *(unsigned int *)((char *)*(void **)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3deda8) + 0x20) + 288)

# batch 0: sprite count
expr -- *(int *)((char *)*(void **)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3deda8) + 0x20) + 292)

# batch 0: vertex scratch
expr -- *(void * *)((char *)*(void **)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3deda8) + 0x20) + 296)

# batch 0: index VBO
expr -- *(unsigned int *)((char *)*(void **)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3deda8) + 0x20) + 304)

# batch 0: ARRAY VBO
expr -- *(unsigned int *)((char *)*(void **)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3deda8) + 0x20) + 308)

# batch 0: batch flag (0 world, 1 screen)
expr -- *(unsigned char *)((char *)*(void **)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3deda8) + 0x20) + 340)

# batch 1: capacity
expr -- *(unsigned int *)((char *)*(void **)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3deda8) + 0x28) + 288)

# batch 1: sprite count
expr -- *(int *)((char *)*(void **)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3deda8) + 0x28) + 292)

# batch 1: vertex scratch
expr -- *(void * *)((char *)*(void **)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3deda8) + 0x28) + 296)

# batch 1: index VBO
expr -- *(unsigned int *)((char *)*(void **)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3deda8) + 0x28) + 304)

# batch 1: ARRAY VBO
expr -- *(unsigned int *)((char *)*(void **)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3deda8) + 0x28) + 308)

# batch 1: batch flag (0 world, 1 screen)
expr -- *(unsigned char *)((char *)*(void **)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3deda8) + 0x28) + 340)

# batch 2: capacity
expr -- *(unsigned int *)((char *)*(void **)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3deda8) + 0x30) + 288)

# batch 2: sprite count
expr -- *(int *)((char *)*(void **)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3deda8) + 0x30) + 292)

# batch 2: vertex scratch
expr -- *(void * *)((char *)*(void **)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3deda8) + 0x30) + 296)

# batch 2: index VBO
expr -- *(unsigned int *)((char *)*(void **)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3deda8) + 0x30) + 304)

# batch 2: ARRAY VBO
expr -- *(unsigned int *)((char *)*(void **)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3deda8) + 0x30) + 308)

# batch 2: batch flag (0 world, 1 screen)
expr -- *(unsigned char *)((char *)*(void **)((char *)*(void **)((uint64_t)&_mh_execute_header + 0x3deda8) + 0x30) + 340)

# clip[9] wide message strip: x
expr -- ((double *)((uint64_t)&_mh_execute_header + 0x3de058))[36]

# clip[9] wide message strip: y
expr -- ((double *)((uint64_t)&_mh_execute_header + 0x3de058))[37]

# clip[9] wide message strip: w
expr -- ((double *)((uint64_t)&_mh_execute_header + 0x3de058))[38]

# clip[9] wide message strip: h
expr -- ((double *)((uint64_t)&_mh_execute_header + 0x3de058))[39]

# clip[28] wide message window: x
expr -- ((double *)((uint64_t)&_mh_execute_header + 0x3de058))[112]

# clip[28] wide message window: y
expr -- ((double *)((uint64_t)&_mh_execute_header + 0x3de058))[113]

# clip[28] wide message window: w
expr -- ((double *)((uint64_t)&_mh_execute_header + 0x3de058))[114]

# clip[28] wide message window: h
expr -- ((double *)((uint64_t)&_mh_execute_header + 0x3de058))[115]
